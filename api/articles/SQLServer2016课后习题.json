\\学生数据.ndf&#x27;</span>,</span><br><span class=\"line\">\tmaxsize <span class=\"operator\">=</span> <span class=\"number\">100</span>mb,</span><br><span class=\"line\">\tsize <span class=\"operator\">=</span> <span class=\"number\">3</span>mb,</span><br><span class=\"line\">\tfilegrowth <span class=\"operator\">=</span> <span class=\"number\">2</span>mb</span><br><span class=\"line\">),</span><br><span class=\"line\">filegroup 学生辅助文件 (</span><br><span class=\"line\">\tname <span class=\"operator\">=</span> 学生辅助文件,</span><br><span class=\"line\">\tfilename <span class=\"operator\">=</span> <span class=\"string\">&#x27;C:\\SQLDATA\\学生辅助文件.ndf&#x27;</span>,</span><br><span class=\"line\">\tsize <span class=\"operator\">=</span> <span class=\"number\">2</span>mb,</span><br><span class=\"line\">\tmaxsize <span class=\"operator\">=</span> unlimited,</span><br><span class=\"line\">\tfilegrowth <span class=\"operator\">=</span> <span class=\"number\">5</span><span class=\"operator\">%</span></span><br><span class=\"line\">)</span><br><span class=\"line\">log <span class=\"keyword\">on</span> (</span><br><span class=\"line\">\tname <span class=\"operator\">=</span> 学生日志,</span><br><span class=\"line\">\tfilename <span class=\"operator\">=</span> <span class=\"string\">&#x27;C:\\SQLDATA\\学生日志.ldf&#x27;</span>,</span><br><span class=\"line\">\tmaxsize <span class=\"operator\">=</span> <span class=\"number\">100</span>mb,</span><br><span class=\"line\">\tsize <span class=\"operator\">=</span> <span class=\"number\">1</span>mb,</span><br><span class=\"line\">\tfilegrowth <span class=\"operator\">=</span> <span class=\"number\">10</span>mb</span><br><span class=\"line\">)</span><br></pre></td></tr></table></figure>\n<blockquote>\n<p>使用T-SQL语句在数据库”学生库”中创建表”班级表“和”学生表“，表的结构自拟，要求适当使用数据类型、PRIMARY KEY 约束、FOREIGN KEY约束、CHECK约束、DEFAULT定义、NO NULL定义。</p>\n</blockquote>\n<figure class=\"highlight sql\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br><span class=\"line\